{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "lf",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended",
			"tailwind": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"style": {
				"useImportType": "error",
				"useExportType": "error",
				"noNonNullAssertion": "error"
			},
			"suspicious": {
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["error", "warn"]
					}
				}
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "error",
					"fix": "safe"
				}
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"parser": {
			"jsxEverywhere": false
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"html": {
		"formatter": {
			"enabled": true
		}
	}
}
